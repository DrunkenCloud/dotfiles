configuration {
    modes: [ drun, window, run, combi ];
    combi-modes: [ window, drun, run ];
    show-icons: true;
    icon-theme: "Yaru-magenta-dark";
    drun-display-format: "{name}";
    display-drun: "";
    display-window: "";
    display-run: "";
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

@import "colors.rasi"

/* GNOME-style launcher: search pill on top, apps as a simple list */
window {
    width: 560px;
    border-radius: 20px;
    background-color: @bg;
    border: 1px;
    border-color: #ffffff1a;
    padding: 18px;
}
mainbox { spacing: 14px; children: [ inputbar, listview ]; }
inputbar {
    background-color: @surface;
    border-radius: 999px;
    padding: 10px 18px;
    spacing: 10px;
    children: [ icon-search, entry ];
}
icon-search { expand: false; filename: "system-search-symbolic"; size: 20px; vertical-align: 0.5; }
entry { placeholder: "Type to search"; placeholder-color: @dim; vertical-align: 0.5; }
listview {
    columns: 1;
    lines: 8;
    spacing: 2px;
    fixed-height: false;
    scrollbar: false;
}
element {
    orientation: horizontal;
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 12px;
    text-color: @fg;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @hover; text-color: @fg; }
element-icon { size: 32px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; font: "Ubuntu Sans 12"; text-color: inherit; }
