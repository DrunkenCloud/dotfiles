configuration {
    modes: [ drun, window, run, combi ];
    combi-modes: [ window, drun, run ];
    show-icons: false;
    /* App name, then its category in a smaller dim font, e.g. "Brave Web Browser  Web Browser".
       The [ ] part is left out when an app has no category. */
    drun-display-format: "{name}[<span size='small' foreground='#8b7aa8'>   {generic}</span>]";
    display-drun: "";
    display-window: "";
    display-run: "";
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

@import "colors.rasi"

/* Text-only launcher: search bar on top, then a clean list */
window {
    width: 520px;
    border-radius: 18px;
    background-color: #14121ce0;   /* ~88% opaque: wallpaper shows through softly */
    border: 1px;
    border-color: @border-col;
    padding: 14px;
}
mainbox { spacing: 10px; children: [ inputbar, listview ]; }

inputbar {
    background-color: @surface;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 10px;
    children: [ entry, num-filtered-rows ];
}
entry {
    placeholder: "Search apps...";
    placeholder-color: @dim;
    text-color: #ffffff;           /* what you type */
    cursor-color: #ffffff;
    font: "Ubuntu Sans 13";
    vertical-align: 0.5;
}
num-filtered-rows { text-color: @dim; font: "Ubuntu Sans 10"; vertical-align: 0.5; expand: false; }

listview {
    columns: 1;
    lines: 8;
    spacing: 2px;
    fixed-height: false;
    scrollbar: false;
    border: 0px;   /* drop rofi's default dashed separator */
}
element {
    padding: 10px 14px;
    border-radius: 10px;
    text-color: @fg;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element selected.normal {
    background-color: @hover;
    text-color: #ffffff;
}
element-text {
    font: "Ubuntu Sans 12";
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold #ffffff;       /* letters matching your search */
}
